# === Environment ===
ENVIRONMENT=local                 # local | production

# === LLM Backends (free-tier primaries: gemini + groq — 2026-09-03) ===
LLM_BACKEND=gemini                # gemini | groq (+ opt-in fallbacks: ollama_qwen3 | ollama_phi4mini | cerebras | claude)
RAGAS_JUDGE_BACKEND=gemini        # gemini | groq (never use a local model for judging)

# === API Keys & Hosts ===
# --- Gemini (FREE primary: flash-lite has the larger daily bucket) ---
# Permanently on flash-lite (2026-09-02): gemini-3.5-flash returns 503
# high-demand on the free tier + 20 req/day cap. Re-test flash before switching.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (FREE fallback, 30 RPM) ---
# llama-3.3-70b-versatile decommissioned on Groq; use openai/gpt-oss-120b.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Optional fallbacks (not needed for free-tier runs) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIMARY=qwen3:4b
OLLAMA_MODEL_SECONDARY=phi4-mini

CEREBRAS_API_KEY=                # Optional fallback
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

ANTHROPIC_API_KEY=                # Optional fallback

# === RAGAS Judge ===
RAGAS_JUDGE_MODEL=gemini-3.5-flash-lite

# === Eval guard ===
EVAL_TOKEN=                  # empty = open (dev default); set a random secret in production — POST /eval/run then requires the x-eval-token header

# === Embedding Model ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# === Reranker Model (default since 2026-09-04: bge-base won the A/B; MiniLM fallback) ===
RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # lightweight fallback (~80 MB)

# === Retrieval Settings ===
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60

# === Context Compression ===
COMPRESSION_THRESHOLD=0.3         # only applied when context exceeds MAX_CONTEXT_TOKENS
MAX_CONTEXT_TOKENS=2000

# === Paths (relative to project root) ===
CHROMA_DB_PATH=data/chroma_db
BM25_INDEX_PATH=data/bm25_index
SQLITE_DB_PATH=data/hybrid_rag.db
QA_SETS_PATH=data/qa_sets
SAMPLE_DOCS_PATH=sample_docs
UPLOAD_DIR=data/uploads

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
