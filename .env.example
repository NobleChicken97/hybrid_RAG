# === Environment ===
ENVIRONMENT=local                 # local | production

# === LLM Backends ===
LLM_BACKEND=gemini                # ollama_qwen3 | ollama_phi4mini | cerebras | groq | gemini | claude
RAGAS_JUDGE_BACKEND=gemini        # cerebras | groq | gemini | claude (never use a local model for judging)

# === API Keys & Hosts ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIMARY=qwen3:4b
OLLAMA_MODEL_SECONDARY=phi4-mini

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (first-party OpenAI-compatible endpoint)
# Free-tier note (2026-09-01): gemini-3.5-flash = 20 requests/day;
# gemini-3.5-flash-lite has a separate, larger daily bucket.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

ANTHROPIC_API_KEY=                # Optional

# === RAGAS Judge ===
RAGAS_JUDGE_MODEL=gemini-3.5-flash-lite

# === Embedding Model ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# === Reranker Model ===
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# === Retrieval Settings ===
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60

# === Context Compression ===
COMPRESSION_THRESHOLD=0.3         # only applied when context exceeds MAX_CONTEXT_TOKENS
MAX_CONTEXT_TOKENS=2000

# === Paths (relative to project root) ===
CHROMA_DB_PATH=data/chroma_db
BM25_INDEX_PATH=data/bm25_index
SQLITE_DB_PATH=data/hybrid_rag.db
QA_SETS_PATH=data/qa_sets
SAMPLE_DOCS_PATH=sample_docs
UPLOAD_DIR=data/uploads

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
