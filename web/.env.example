# FastAPI backend URL (client-side fetch target).
# Local dev:  http://localhost:8000 (talk to the backend directly), or leave
#             UNSET and `npm run dev` proxies the relative /api/* prefix via
#             the next.config.ts rewrite (BACKEND_INTERNAL_URL override below).
# Compose:    leave UNSET — Caddy serves /api/* from the backend (see
#             deploy/Caddyfile); the browser must never get an internal
#             hostname like http://backend:8000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Next.js dev-server API proxy target (only used for the /api/* rewrite when
# NEXT_PUBLIC_BACKEND_URL is unset). On the Windows dev box port 8000 is
# taken by Docker/WSL, so the backend runs on 8001 there.
# BACKEND_INTERNAL_URL=http://localhost:8001
